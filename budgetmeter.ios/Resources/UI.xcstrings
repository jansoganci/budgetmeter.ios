    "auth.error.delete_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل حذف الحساب. يرجى المحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontolöschung fehlgeschlagen. Bitte versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account deletion failed. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error al eliminar la cuenta. Inténtalo de nuevo."
          }
        },
