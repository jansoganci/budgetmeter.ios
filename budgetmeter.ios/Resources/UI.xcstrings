    "backup.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقطة اختيارية كاملة للجهاز للاستعادة المتقدمة. منفصلة عن مزامنة الحساب اليومية. يتم أخذ لقطة للبيانات المحلية قبل النسخ الاحتياطي أو الاستعادة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionale vollständige Gerätesicherung für erweiterte Wiederherstellung. Getrennt von der täglichen Kontosynchronisierung. Lokale Daten werden vor Backup oder Wiederherstellung gesichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional full-device snapshot for advanced recovery. This is separate from everyday account sync. Local data is snapshotted before backup or restore."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instantánea opcional del dispositivo completo para recuperación avanzada. Separada de la sincronización diaria de la cuenta. Los datos locales se guardan antes de la copia o restauración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instantané complet optionnel de l'appareil pour une récupération avancée. Séparé de la synchronisation quotidienne du compte. Les données locales sont sauvegardées avant sauvegarde ou restauration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Istantanea completa opzionale del dispositivo per recupero avanzato. Separata dalla sincronizzazione quotidiana dell'account. I dati locali vengono salvati prima del backup o ripristino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高度な復旧のための任意の全デバイススナップショット。日常のアカウント同期とは別です。バックアップまたは復元の前にローカルデータのスナップショットを取得します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Instantâneo completo opcional do dispositivo para recuperação avançada. Separado da sincronização diária da conta. Os dados locais são salvos antes do backup ou restauração."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelişmiş kurtarma için isteğe bağlı tam cihaz anlık görüntüsü. Günlük hesap eşitlemesinden ayrıdır. Yedekleme veya geri yüklemeden önce yerel verilerin anlık görüntüsü alınır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于高级恢复的可选全设备快照。与日常账户同步分开。在备份或恢复前会对本地数据创建快照。"
          }
        }
      }
    },
