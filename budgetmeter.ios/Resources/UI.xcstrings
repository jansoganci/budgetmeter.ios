    "health.detail.description.excellent": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عمل ممتاز! صحتك المالية رائعة. استمر في العادات الجيدة!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgezeichnete Arbeit! Ihre finanzielle Gesundheit ist hervorragend. Behalten Sie die guten Gewohnheiten bei!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excellent work! Your financial health is outstanding. Keep up the great habits!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Excelente trabajo! Tu salud financiera es sobresaliente. ¡Sigue con los buenos hábitos!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Excellent travail ! Votre santé financière est remarquable. Continuez vos bonnes habitudes !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottimo lavoro! La tua salute finanziaria è eccellente. Continua con le buone abitudini!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "素晴らしいです！財務健全性は非常に良好です。この調子で良い習慣を続けましょう！"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Excelente trabalho! Sua saúde financeira está excelente. Continue com os bons hábitos!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harika iş! Finansal sağlığınız mükemmel. İyi alışkanlıklarınızı sürdürün!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "做得好！您的财务健康状况非常出色。请继续保持良好习惯！"
          }
        }
      }
    },
    "health.detail.description.fair": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بداية مقبولة. صحتك المالية تحتاج إلى اهتمام. راجع النصائح أدناه للإرشاد."
          }
