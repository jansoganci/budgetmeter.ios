          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap silindi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户已删除。"
          }
        }
      }
    },
