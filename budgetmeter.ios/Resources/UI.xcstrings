    "widgets.setup.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف ويدجت BudgetMeter إلى الشاشة الرئيسية وشاشة القفل لعرض بياناتك المالية بسرعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie BudgetMeter-Widgets zu Ihrem Startbildschirm und Sperrbildschirm hinzu, um Ihre Finanzdaten schnell anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add BudgetMeter widgets to your Home Screen and Lock Screen to quickly view your financial data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega widgets de BudgetMeter a tu pantalla de inicio y pantalla de bloqueo para ver rápidamente tus datos financieros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des widgets BudgetMeter à votre écran d'accueil et écran de verrouillage pour afficher rapidement vos données financières."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi widget BudgetMeter alla schermata principale e schermata di blocco per visualizzare rapidamente i tuoi dati finanziari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面とロック画面にBudgetMeterウィジェットを追加して、財務データをすばやく表示します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione widgets do BudgetMeter à sua tela inicial e tela de bloqueio para visualizar rapidamente seus dados financeiros."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finansal verilerinizi hızlıca görüntülemek için BudgetMeter widget'larını Ana Ekran ve Kilit Ekranınıza ekleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将BudgetMeter小组件添加到主屏幕和锁定屏幕，快速查看您的财务数据。"
          }
        }
      }
    },
    "widgets.setup.description.v1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف ويدجت الوتيرة اليومية الصافية من BudgetMeter إلى شاشتك الرئيسية لمعرفة ما إذا كنت تتقدم أو تتباطأ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge das BudgetMeter-Netto-Tagespace-Widget zu deinem Startbildschirm hinzu, um zu sehen, ob du vorankommst oder langsamer wirst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the BudgetMeter net daily pace widget to your Home Screen to see whether you're moving forward or slowing down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega el widget de ritmo diario neto de BudgetMeter a tu pantalla de inicio para ver si avanzas o te estás frenando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez le widget de rythme quotidien net BudgetMeter à votre écran d'accueil pour voir si vous avancez ou ralentissez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi il widget del ritmo giornaliero netto di BudgetMeter alla schermata Home per scoprire se stai avanzando o rallentando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BudgetMeterの日次ネットペースウィジェットをホーム画面に追加して、前進しているか減速しているかを確認しましょう。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o widget de ritmo diário líquido do BudgetMeter à tela inicial para ver se você está avançando ou desacelerando."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerleyip ilerlemediğinizi veya yavaşlayıp yavaşlamadığınızı görmek için BudgetMeter net günlük tempo widget'ını Ana Ekranınıza ekleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 BudgetMeter 每日净节奏小组件添加到主屏幕，查看你是在前进还是放缓。"
          }
        }
      }
    },
