    "settings.terms.policy.acceptance.content": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بتحميل واستخدام BudgetMeter، أنت توافق على شروط الخدمة هذه."
