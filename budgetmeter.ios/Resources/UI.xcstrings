    "account.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الدخول مجاني ويزامن بياناتك مع حسابك. النسخ الاحتياطي والاستعادة اليدويان ميزة Premium."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung ist kostenlos und synchronisiert Ihre Daten mit Ihrem Konto. Manuelles Backup & Wiederherstellen ist eine Premium-Funktion."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in is free and syncs your data to your account. Manual backup & restore is a Premium feature."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sesión es gratis y sincroniza tus datos con tu cuenta. La copia de seguridad y restauración manual es una función Premium."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion est gratuite et synchronise vos données avec votre compte. La sauvegarde et la restauration manuelles sont une fonctionnalité Premium."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso è gratuito e sincronizza i dati con il tuo account. Backup e ripristino manuali sono una funzione Premium."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインは無料で、アカウントにデータを同期します。手動バックアップと復元はプレミアム機能です。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O login é gratuito e sincroniza seus dados com sua conta. Backup e restauração manuais são um recurso Premium."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş ücretsizdir ve verilerinizi hesabınıza eşitler. Manuel yedekleme ve geri yükleme Premium özelliğidir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录免费，并将数据同步到您的账户。手动备份和恢复是高级功能。"
          }
        }
      }
    },
