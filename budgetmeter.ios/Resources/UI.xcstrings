    "onboarding.page1.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاهد كيف تتدفق إيراداتك ومصروفاتك في الوقت الفعلي — مثل عداد حي لأموالك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehen Sie, wie Einkommen und Ausgaben in Echtzeit fließen — wie ein Live-Zähler für Ihre Finanzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See how your income and expenses flow in real time — like a live meter for your finances."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Observa cómo fluyen tus ingresos y gastos en tiempo real — como un medidor en vivo para tus finanzas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez comment vos revenus et dépenses circulent en temps réel — comme un compteur vivant pour vos finances."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda come entrate e spese fluiscono in tempo reale — come un contatore live per le tue finanze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "収入と支出がリアルタイムで流れる様子を確認 — まるで財務のライブメーターのように。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja como sua renda e despesas fluem em tempo real — como um medidor ao vivo para suas finanças."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelir ve giderlerinizin gerçek zamanlı akışını görün — finanslarınız için canlı bir gösterge gibi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时了解收入和支出的流动 — 就像您财务的实时仪表。"
          }
        }
      }
    },
    "onboarding.page1.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع وتيرة أموالك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolgen Sie Ihr Geldtempo"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track your money pace"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue el ritmo de tu dinero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez le rythme de votre argent"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitora il ritmo del tuo denaro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お金のペースを追跡"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe o ritmo do seu dinheiro"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paranızın temposunu takip edin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "追踪您的资金节奏"
          }
        }
      }
    },
    "onboarding.page2.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل دخلك المتكرر وفئات الإنفاق لبناء وتيرة أموالك الشخصية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie wiederkehrende Einkommen und Ausgabenkategorien ein, um Ihr persönliches Geldtempo aufzubauen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your recurring income and spending categories to build your personal money pace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce tus ingresos recurrentes y categorías de gasto para crear tu ritmo de dinero personal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez vos revenus récurrents et catégories de dépenses pour construire votre rythme financier personnel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci le tue entrate ricorrenti e categorie di spesa per costruire il tuo ritmo finanziario personale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "定期的な収入と支出カテゴリを入力して、あなた独自のお金のペースを作りましょう。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira sua renda recorrente e categorias de gastos para construir seu ritmo financeiro pessoal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel para temponuzu oluşturmak için düzenli gelir ve harcama kategorilerinizi girin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入您的经常性收入和支出类别，建立个人资金节奏。"
          }
        }
      }
    },
    "onboarding.page2.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف دخلك ومصروفاتك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie Einkommen & Ausgaben hinzu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your income & expenses"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tus ingresos y gastos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez vos revenus et dépenses"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi entrate e spese"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "収入と支出を追加"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione sua renda e despesas"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelir ve giderlerinizi ekleyin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加您的收入和支出"
          }
        }
      }
    },
    "onboarding.page3.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع ميزانيتك اليومية ودرجة الصحة وأهداف الادخار — كل ذلك في لوحة هادئة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beobachten Sie Tagesbudget, Gesundheitsscore und Sparziele — alles in einem ruhigen Dashboard."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch your daily budget, health score, and savings goals — all in one calm dashboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta tu presupuesto diario, puntuación de salud y metas de ahorro — todo en un panel tranquilo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez votre budget quotidien, score de santé et objectifs d'épargne — le tout dans un tableau de bord serein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitora budget giornaliero, punteggio salute e obiettivi di risparmio — tutto in una dashboard calma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日々の予算、ヘルススコア、貯蓄目標を確認 — すべて穏やかなダッシュボードで。"
