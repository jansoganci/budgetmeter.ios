    "subscription.delete_confirm_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف هذا الاشتراك بشكل دائم. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies löscht dieses Abonnement dauerhaft. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will permanently delete this subscription. This action cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará permanentemente esta suscripción. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera définitivement cet abonnement. Cette action ne peut pas être annulée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo eliminerà permanentemente questo abbonamento. Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサブスクリプションを完全に削除します。この操作は元に戻せません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso excluirá permanentemente esta assinatura. Esta ação não pode ser desfeita."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, bu aboneliği kalıcı olarak silecektir. Bu işlem geri alınamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除此订阅。此操作无法撤销。"
          }
        }
      }
    },
    "subscription.delete_confirm_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
