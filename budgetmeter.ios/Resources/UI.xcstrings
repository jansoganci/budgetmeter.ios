    "settings.privacy.policy.data_storage.content": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "• محلي: قاعدة بيانات Core Data على جهازك\n• مزامنة الحساب: Supabase (عند تسجيل الدخول)\n• نسخ احتياطي يدوي (Premium، اختياري): لقطة كاملة في user_backups"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "• Lokal: Core-Data-Datenbank auf Ihrem Gerät\n• Kontosynchronisierung: Supabase (bei Anmeldung)\n• Manuelles Backup (Premium, optional): vollständige Sicherung in user_backups"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Local: Core Data database on your device\n• Account sync: Supabase (when signed in)\n• Manual backup (Premium, optional): full snapshot in user_backups"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "• Local: base de datos Core Data en tu dispositivo\n• Sincronización de cuenta: Supabase (con sesión iniciada)\n• Copia manual (Premium, opcional): instantánea completa en user_backups"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Local : base de données Core Data sur votre appareil\n• Synchronisation du compte : Supabase (connecté)\n• Sauvegarde manuelle (Premium, optionnelle) : instantané complet dans user_backups"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "• Locale: database Core Data sul dispositivo\n• Sincronizzazione account: Supabase (con accesso)\n• Backup manuale (Premium, opzionale): snapshot completo in user_backups"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• ローカル: デバイスのCore Dataデータベース\n• アカウント同期: Supabase（サインイン時）\n• 手動バックアップ（プレミアム、任意）: user_backups内の完全スナップショット"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "• Local: banco de dados Core Data no dispositivo\n• Sincronização da conta: Supabase (conectado)\n• Backup manual (Premium, opcional): instantâneo completo em user_backups"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Yerel: Cihazınızdaki Core Data veritabanı\n• Hesap eşitleme: Supabase (giriş yapıldığında)\n• Manuel yedekleme (Premium, isteğe bağlı): user_backups içinde tam anlık görüntü"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "• 本地：设备上的 Core Data 数据库\n• 账户同步：Supabase（登录时）\n• 手动备份（高级，可选）：user_backups 中的完整快照"
          }
        }
      }
    },
