    "health.a11y.detail_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صحتك المالية الإجمالية بناءً على الالتزام بالميزانية والادخار واتساق الإنفاق واستقرار الدخل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre gesamte finanzielle Gesundheit basierend auf Budgeteinhaltung, Ersparnissen, Ausgabenkonsistenz und Einkommensstabilität"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your overall financial health based on budget compliance, savings, spending consistency, and income stability"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu salud financiera general basada en cumplimiento del presupuesto, ahorros, consistencia de gastos y estabilidad de ingresos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre santé financière globale basée sur le respect du budget, l'épargne, la régularité des dépenses et la stabilité des revenus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua salute finanziaria complessiva basata su rispetto del budget, risparmi, coerenza delle spese e stabilità del reddito"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予算遵守、貯蓄、支出の一貫性、収入の安定性に基づく総合的な財務健全性"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua saúde financeira geral baseada em cumprimento do orçamento, poupança, consistência de gastos e estabilidade de renda"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütçe uyumu, tasarruf, harcama tutarlılığı ve gelir istikrarına dayalı genel finansal sağlığınız"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于预算遵守、储蓄、支出一致性和收入稳定性的整体财务健康"
          }
        }
      }
    },
