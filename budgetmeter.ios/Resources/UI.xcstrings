    "settings.terms.policy.license.content": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نمنحك ترخيصاً شخصياً غير تجاري لاستخدام BudgetMeter لإدارة شؤونك المالية الشخصية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir gewähren Ihnen eine persönliche, nicht-kommerzielle Lizenz zur Nutzung von BudgetMeter für die Verwaltung Ihrer persönlichen Finanzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We grant you a personal, non-commercial license to use BudgetMeter for managing your personal finances."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Le otorgamos una licencia personal y no comercial para usar BudgetMeter para gestionar sus finanzas personales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vous accordons une licence personnelle et non commerciale pour utiliser BudgetMeter pour gérer vos finances personnelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti concediamo una licenza personale e non commerciale per utilizzare BudgetMeter per gestire le tue finanze personali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人の財務管理のためにBudgetMeterを使用するための個人的で非商用のライセンスを付与します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Concedemos a você uma licença pessoal e não comercial para usar o BudgetMeter para gerenciar suas finanças pessoais."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel finanslarınızı yönetmek için BudgetMeter'ı kullanmanız için size kişisel, ticari olmayan bir lisans veriyoruz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们授予您个人、非商业许可，以使用BudgetMeter管理您的个人财务。"
          }
        }
      }
    },
