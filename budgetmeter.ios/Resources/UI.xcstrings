      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صحتك المالية تحتاج إلى تحسين. اتبع التوصيات للعودة إلى المسار الصحيح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre finanzielle Gesundheit muss verbessert werden. Folgen Sie den Empfehlungen, um wieder auf Kurs zu kommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your financial health needs improvement. Follow the recommendations to get back on track."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu salud financiera necesita mejorar. Sigue las recomendaciones para volver al buen camino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre santé financière doit être améliorée. Suivez les recommandations pour reprendre le bon chemin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua salute finanziaria ha bisogno di miglioramenti. Segui i consigli per rimetterti in carreggiata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "財務健全性の改善が必要です。推奨事項に従って軌道に戻りましょう。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua saúde financeira precisa melhorar. Siga as recomendações para voltar ao caminho certo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finansal sağlığınızın iyileştirilmesi gerekiyor. Yola geri dönmek için önerileri izleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的财务健康需要改善。请遵循建议重回正轨。"
          }
        }
      }
    },
