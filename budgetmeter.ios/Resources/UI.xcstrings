    "settings.privacy.policy.data_sharing.content": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا نبيع بياناتك الشخصية. تستخدم مزامنة الحساب والنسخ الاحتياطي اليدوي الاختياري Supabase عبر HTTPS. لا نشارك بياناتك مع المعلنين أو أطراف ثالثة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir verkaufen Ihre personenbezogenen Daten nicht. Kontosynchronisierung und optionales manuelles Backup nutzen Supabase über HTTPS. Wir teilen Ihre Daten nicht mit Werbetreibenden oder Dritten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We do not sell your personal data. Account sync and optional manual backup use Supabase over HTTPS. We do not share your data with advertisers or other third parties."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No vendemos tus datos personales. La sincronización de cuenta y la copia manual opcional usan Supabase por HTTPS. No compartimos tus datos con anunciantes ni terceros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous ne vendons pas vos données personnelles. La synchronisation du compte et la sauvegarde manuelle optionnelle utilisent Supabase via HTTPS. Nous ne partageons pas vos données avec des annonceurs ou des tiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non vendiamo i tuoi dati personali. La sincronizzazione dell'account e il backup manuale opzionale usano Supabase via HTTPS. Non condividiamo i tuoi dati con inserzionisti o terze parti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人データを販売することはありません。アカウント同期と任意の手動バックアップはHTTPS経由でSupabaseを使用します。広告主や第三者とデータを共有することはありません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não vendemos seus dados pessoais. A sincronização da conta e o backup manual opcional usam Supabase via HTTPS. Não compartilhamos seus dados com anunciantes ou terceiros."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel verilerinizi satmıyoruz. Hesap eşitleme ve isteğe bağlı manuel yedekleme HTTPS üzerinden Supabase kullanır. Verilerinizi reklamverenler veya üçüncü taraflarla paylaşmıyoruz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们不出售您的个人数据。账户同步和可选的手动备份通过 HTTPS 使用 Supabase。我们不会与广告商或其他第三方共享您的数据。"
          }
        }
      }
    },
