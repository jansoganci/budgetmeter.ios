{
  "sourceLanguage": "en",
  "strings": {
    "account.delete.confirm": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sil"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        }
      }
    },
    "account.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف هذا حسابك وبياناتك المتزامنة على خوادمنا بشكل دائم. تبقى البيانات على هذا الجهاز ما لم تُعاد تعيينها بشكل منفصل في الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies löscht dauerhaft Ihr Konto und synchronisierte Daten auf unseren Servern. Daten auf diesem Gerät bleiben erhalten, sofern Sie sie nicht separat in den Einstellungen zurücksetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes your account and synced data on our servers. Data on this device stays unless you reset it separately in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente tu cuenta y los datos sincronizados en nuestros servidores. Los datos en este dispositivo permanecen a menos que los restablezcas por separado en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement votre compte et les données synchronisées sur nos serveurs. Les données sur cet appareil restent sauf si vous les réinitialisez séparément dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elimina definitivamente il tuo account e i dati sincronizzati sui nostri server. I dati su questo dispositivo restano a meno che non li reimposti separatamente in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントとサーバー上の同期データが永久に削除されます。このデバイスのデータは、設定で別途リセットしない限り残ります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso exclui permanentemente sua conta e os dados sincronizados em nossos servidores. Os dados neste dispositivo permanecem, a menos que você os redefina separadamente em Ajustes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem hesabınızı ve sunucularımızdaki eşitlenmiş verileri kalıcı olarak siler. Bu cihazdaki veriler, Ayarlar'dan ayrıca sıfırlamadığınız sürece kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除您的账户及我们服务器上的同步数据。除非您在设置中单独重置，否则此设备上的数据会保留。"
          }
        }
      }
    },
