        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe seu orçamento diário, pontuação de saúde e metas de poupança — tudo em um painel tranquilo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük bütçenizi, sağlık skorunuzu ve tasarruf hedeflerinizi izleyin — hepsi sakin bir panoda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看每日预算、健康评分和储蓄目标 — 全部在一个简洁的仪表板中。"
          }
        }
