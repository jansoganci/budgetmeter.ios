    "settings.terms.policy.warranty.content": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم توفير التطبيق 'كما هو' دون أي ضمانات من أي نوع، صريحة أو ضمنية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App wird 'wie besehen' ohne Gewährleistungen jeglicher Art, ausdrücklich oder stillschweigend, bereitgestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is provided 'as-is' without warranties of any kind, express or implied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación se proporciona 'tal cual' sin garantías de ningún tipo, expresas o implícitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application est fournie 'telle quelle' sans garanties d'aucune sorte, expresses ou implicites."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app è fornita 'così com'è' senza garanzie di alcun tipo, espresse o implicite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリは「現状のまま」で、明示的または黙示的ないかなる種類の保証もなく提供されます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplicativo é fornecido 'como está' sem garantias de qualquer tipo, expressas ou implícitas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama, açık veya zımni herhangi bir tür garanti olmaksızın 'olduğu gibi' sağlanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用按“原样”提供，不提供任何明示或暗示的保证。"
          }
        }
      }
    },
