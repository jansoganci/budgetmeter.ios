    "account.sign_in_prompt": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول لمزامنة بيانات حسابك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich an, um Ihre Kontodaten zu synchronisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to sync your account data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para sincronizar los datos de tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour synchroniser les données de votre compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi per sincronizzare i dati del tuo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントデータを同期するにはサインインしてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre para sincronizar os dados da sua conta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap verilerinizi eşitlemek için giriş yapın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录以同步您的账户数据。"
          }
        }
      }
    },
    "sync.section.title": {
