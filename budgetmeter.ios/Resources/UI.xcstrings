    "sync.footer.signed_in": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تسجيل الدخول، تتم مزامنة بيانات BudgetMeter بأمان مع حسابك. تعمل المزامنة بعد تسجيل الدخول وعند إجراء التغييرات. قد يستغرق ظهورها على جهاز آخر لحظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie sich anmelden, werden Ihre BudgetMeter-Daten sicher mit Ihrem Konto synchronisiert. Die Synchronisierung erfolgt nach der Anmeldung und bei Änderungen. Es kann einen Moment dauern, bis sie auf einem anderen Gerät erscheinen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you sign in, your BudgetMeter data syncs securely to your account. Sync runs after sign-in and when you make changes. It may take a moment to appear on another device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando inicias sesión, tus datos de BudgetMeter se sincronizan de forma segura con tu cuenta. La sincronización se ejecuta después del inicio de sesión y cuando realizas cambios. Puede tardar un momento en aparecer en otro dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous vous connectez, vos données BudgetMeter sont synchronisées en toute sécurité avec votre compte. La synchronisation s'exécute après la connexion et lorsque vous apportez des modifications. L'affichage sur un autre appareil peut prendre un moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando accedi, i tuoi dati BudgetMeter vengono sincronizzati in modo sicuro con il tuo account. La sincronizzazione avviene dopo l'accesso e quando apporti modifiche. Potrebbe volerci un momento prima che appaia su un altro dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインすると、BudgetMeterのデータがアカウントに安全に同期されます。同期はサインイン後および変更時に実行されます。別のデバイスに表示されるまで少し時間がかかる場合があります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você entra, seus dados do BudgetMeter são sincronizados com segurança com sua conta. A sincronização ocorre após o login e quando você faz alterações. Pode levar um momento para aparecer em outro dispositivo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş yaptığınızda BudgetMeter verileriniz hesabınıza güvenle eşitlenir. Eşitleme, girişten sonra ve değişiklik yaptığınızda çalışır. Başka bir cihazda görünmesi biraz zaman alabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后，您的 BudgetMeter 数据会安全同步到您的账户。同步在登录后以及您进行更改时运行。在其他设备上显示可能需要一些时间。"
          }
        }
      }
    },
    "sync.footer.signed_out": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول لحفظ إعداداتك وبياناتك المالية في حسابك واستخدامها على جهاز آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich an, um Ihre Einstellungen und Finanzdaten in Ihrem Konto zu speichern und auf einem anderen Gerät zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to save your settings and financial data to your account and use it on another device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para guardar tus ajustes y datos financieros en tu cuenta y usarlos en otro dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour enregistrer vos réglages et données financières dans votre compte et les utiliser sur un autre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi per salvare impostazioni e dati finanziari nel tuo account e usarli su un altro dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定と財務データをアカウントに保存し、別のデバイスで使用するにはサインインしてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre para salvar suas configurações e dados financeiros na sua conta e usá-los em outro dispositivo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlarınızı ve finansal verilerinizi hesabınıza kaydetmek ve başka bir cihazda kullanmak için giriş yapın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录以将设置和财务数据保存到您的账户，并在其他设备上使用。"
          }
        }
      }
    },
