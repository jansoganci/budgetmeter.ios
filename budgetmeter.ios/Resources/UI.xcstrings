    "premium.banner.accessibility": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقل إلى Premium. السمات والودجات والرؤى الأعمق. شراء لمرة واحدة. اضغط ترقية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium holen. Themes, Widgets und tiefere Einblicke. Einmaliger Kauf. Tippe auf Upgraden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go Premium. Themes, widgets, and deeper insights. One-time purchase. Tap Upgrade to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazte Premium. Temas, widgets y análisis más profundos. Compra única. Toca Actualizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer Premium. Thèmes, widgets et analyses avancées. Achat unique. Appuyez sur Mettre à niveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa a Premium. Temi, widget e approfondimenti. Acquisto una tantum. Tocca Aggiorna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレミアムへ。テーマ、ウィジェット、詳しい分析。買い切り。アップグレードをタップ。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seja Premium. Temas, widgets e insights mais profundos. Compra única. Toque em Atualizar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium'a geç. Temalar, widget'lar ve daha derin içgörüler. Tek seferlik satın alma. Yükselt'e dokun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "升级高级版。主题、小组件和更深度洞察。一次性购买。点按升级。"
          }
        }
      }
    },
