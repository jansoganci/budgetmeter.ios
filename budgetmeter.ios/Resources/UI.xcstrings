    "settings.privacy.policy.data_use.content": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "• لتوفير وظيفة التتبع المالي\n• لمزامنة بيانات حسابك عند تسجيل الدخول\n• لنسخ واستعادة لقطات يدوية Premium اختيارية عند اختيارك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "• Zur Bereitstellung der Finanzverfolgungsfunktion\n• Zur Synchronisierung Ihrer Kontodaten bei Anmeldung\n• Zum Sichern und Wiederherstellen optionaler Premium-Manualsicherungen auf Wunsch"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• To provide financial tracking functionality\n• To sync your account data when you sign in\n• To back up and restore optional Premium manual snapshots when you choose"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "• Para proporcionar la funcionalidad de seguimiento financiero\n• Para sincronizar los datos de tu cuenta al iniciar sesión\n• Para respaldar y restaurar instantáneas manuales Premium opcionales cuando elijas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Pour fournir la fonctionnalité de suivi financier\n• Pour synchroniser vos données de compte lors de la connexion\n• Pour sauvegarder et restaurer des instantanés manuels Premium optionnels si vous le choisissez"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "• Per fornire la funzionalità di tracciamento finanziario\n• Per sincronizzare i dati dell'account quando accedi\n• Per eseguire backup e ripristino di snapshot manuali Premium opzionali quando scegli"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• 財務追跡機能を提供するため\n• サインイン時にアカウントデータを同期するため\n• 選択時に任意のプレミアム手動スナップショットをバックアップ・復元するため"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "• Para fornecer a funcionalidade de rastreamento financeiro\n• Para sincronizar os dados da sua conta ao entrar\n• Para fazer backup e restaurar instantâneos manuais Premium opcionais quando você escolher"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Finansal takip işlevselliği sağlamak için\n• Giriş yaptığınızda hesap verilerinizi eşitlemek için\n• Seçtiğinizde isteğe bağlı Premium manuel anlık görüntüleri yedeklemek ve geri yüklemek için"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "• 提供财务跟踪功能\n• 在您登录时同步账户数据\n• 在您选择时备份和恢复可选的高级手动快照"
          }
        }
      }
    },
