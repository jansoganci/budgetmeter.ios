    "settings.privacy.policy.data_collect.content": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "• البيانات المالية (الدخل، المصروفات، الفئات) — مخزنة محلياً على جهازك\n• تفضيلات التطبيق (العملة، اللغة) — مخزنة محلياً\n• بيانات مزامنة الحساب (عند تسجيل الدخول) — الإعدادات والأهداف والفواتير والمعاملات والفئات في حساب Supabase\n• لقطات نسخ احتياطي يدوي Premium اختيارية — منفصلة عن المزامنة اليومية"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "• Finanzdaten (Einkommen, Ausgaben, Kategorien) — lokal auf Ihrem Gerät gespeichert\n• App-Einstellungen (Währung, Sprache) — lokal gespeichert\n• Kontosynchronisierungsdaten (bei Anmeldung) — Einstellungen, Ziele, Rechnungen, Transaktionen und Kategorien in Ihrem Supabase-Konto\n• Optionale Premium-Manualsicherungen — getrennt von der täglichen Synchronisierung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Financial data (income, expenses, categories) — stored locally on your device\n• App preferences (currency, language) — stored locally\n• Account sync data (when signed in) — settings, goals, bills, transactions, and categories stored in your Supabase account\n• Optional Premium manual backup snapshots — separate from everyday sync"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "• Datos financieros (ingresos, gastos, categorías) — almacenados localmente en tu dispositivo\n• Preferencias de la app (moneda, idioma) — almacenadas localmente\n• Datos de sincronización de cuenta (con sesión iniciada) — ajustes, metas, facturas, transacciones y categorías en tu cuenta Supabase\n• Instantáneas de copia manual Premium opcionales — separadas de la sincronización diaria"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Données financières (revenus, dépenses, catégories) — stockées localement sur votre appareil\n• Préférences de l'app (devise, langue) — stockées localement\n• Données de synchronisation du compte (connecté) — réglages, objectifs, factures, transactions et catégories dans votre compte Supabase\n• Instantanés de sauvegarde manuelle Premium optionnels — séparés de la synchronisation quotidienne"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "• Dati finanziari (entrate, spese, categorie) — memorizzati localmente sul dispositivo\n• Preferenze app (valuta, lingua) — memorizzate localmente\n• Dati sincronizzazione account (con accesso) — impostazioni, obiettivi, bollette, transazioni e categorie nel tuo account Supabase\n• Snapshot backup manuali Premium opzionali — separati dalla sincronizzazione quotidiana"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• 財務データ（収入、支出、カテゴリ）— デバイスにローカル保存\n• アプリ設定（通貨、言語）— ローカル保存\n• アカウント同期データ（サインイン時）— 設定、目標、請求、取引、カテゴリをSupabaseアカウントに保存\n• 任意のプレミアム手動バックアップスナップショット — 日常の同期とは別"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "• Dados financeiros (receitas, despesas, categorias) — armazenados localmente no dispositivo\n• Preferências do app (moeda, idioma) — armazenadas localmente\n• Dados de sincronização da conta (conectado) — configurações, metas, contas, transações e categorias na sua conta Supabase\n• Instantâneos de backup manual Premium opcionais — separados da sincronização diária"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Finansal veriler (gelir, gider, kategoriler) — cihazınızda yerel olarak saklanır\n• Uygulama tercihleri (para birimi, dil) — yerel olarak saklanır\n• Hesap eşitleme verileri (giriş yapıldığında) — ayarlar, hedefler, faturalar, işlemler ve kategoriler Supabase hesabınızda saklanır\n• İsteğe bağlı Premium manuel yedek anlık görüntüleri — günlük eşitlemeden ayrı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "• 财务数据（收入、支出、类别）— 本地存储在您的设备上\n• 应用偏好（货币、语言）— 本地存储\n• 账户同步数据（登录时）— 设置、目标、账单、交易和类别存储在您的 Supabase 账户\n• 可选的高级手动备份快照 — 与日常同步分开"
          }
        }
      }
    },
