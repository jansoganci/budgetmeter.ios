    "settings.reset.cumulative.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة تعيين العداد طويل المدى"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Langzeit-Zähler zurücksetzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset Long-Term Meter"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablecer Medidor a Largo Plazo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialiser le Compteur à Long Terme"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina Contatore a Lungo Termine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長期メーターをリセット"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Redefinir Medidor de Longo Prazo"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzun Vadeli Sayacı Sıfırla"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置长期计量器"
          }
        }
      }
    },
    "settings.reset.cumulative.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا يعيد تعيين إجماليك طويل المدى فقط. جلستك الحالية تبقى نشطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies setzt nur Ihre Langzeit-Gesamtsumme zurück. Ihre aktuelle Sitzung bleibt aktiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This resets only your long-term total. Your current session stays active."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto restablece solo tu total a largo plazo. Tu sesión actual permanece activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci remet à zéro uniquement votre total à long terme. Votre session actuelle reste active."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo ripristina solo il tuo totale a lungo termine. La tua sessione corrente rimane attiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは長期合計のみをリセットします。現在のセッションはアクティブのままです。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso redefine apenas seu total de longo prazo. Sua sessão atual permanece ativa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sadece uzun vadeli toplamınızı sıfırlar. Mevcut oturumunuz aktif kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这只会重置您的长期总计。您当前的会话保持活跃。"
          }
        }
      }
    },
