    "settings.terms.policy.liability.content": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Our maximum liability is limited to the amount you paid for the app or subscription in the 12 months prior to the claim."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقتصر مسؤوليتنا القصوى على المبلغ الذي دفعته للتطبيق أو الاشتراك في الـ 12 شهراً السابقة للمطالبة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsere maximale Haftung ist auf den Betrag beschränkt, den Sie in den 12 Monaten vor der Forderung für die App oder das Abonnement gezahlt haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuestra responsabilidad máxima está limitada al monto que pagó por la aplicación o suscripción en los 12 meses anteriores al reclamo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notre responsabilité maximale est limitée au montant que vous avez payé pour l'application ou l'abonnement au cours des 12 mois précédant la réclamation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nostra responsabilità massima è limitata all'importo che hai pagato per l'app o l'abbonamento nei 12 mesi precedenti il reclamo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "当社の最大責任は、請求前の12か月間にアプリまたはサブスクリプションに支払った金額に制限されます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nossa responsabilidade máxima é limitada ao valor que você pagou pelo aplicativo ou assinatura nos 12 meses anteriores à reclamação."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksimum sorumluluğumuz, talepten önceki 12 ay içinde uygulama veya abonelik için ödediğiniz tutarla sınırlıdır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们的最大责任限于您在索赔前12个月内为应用或订阅支付的金额。"
          }
        }
      }
    },
