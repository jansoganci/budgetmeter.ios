            "value": "您的权利"
          }
        }
      }
    },
    "settings.privacy.policy.your_rights.content": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Access: View all your data within the app\n• Delete: Reset all data via Settings\n• Control: Disable iCloud sync anytime"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "• الوصول: عرض جميع بياناتك داخل التطبيق\n• الحذف: إعادة تعيين جميع البيانات عبر الإعدادات\n• التحكم: تعطيل مزامنة iCloud في أي وقت"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "• Zugriff: Alle Ihre Daten in der App anzeigen\n• Löschen: Alle Daten über Einstellungen zurücksetzen\n• Kontrolle: iCloud-Synchronisierung jederzeit deaktivieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "• Acceso: Ver todos sus datos dentro de la aplicación\n• Eliminar: Restablecer todos los datos a través de Configuración\n• Control: Desactivar la sincronización de iCloud en cualquier momento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Accès : Voir toutes vos données dans l'application\n• Supprimer : Réinitialiser toutes les données via Paramètres\n• Contrôle : Désactiver la synchronisation iCloud à tout moment"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "• Accesso: Visualizza tutti i tuoi dati nell'app\n• Elimina: Reimposta tutti i dati tramite Impostazioni\n• Controllo: Disattiva la sincronizzazione iCloud in qualsiasi momento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• アクセス: アプリ内で全データを表示\n• 削除: 設定から全データをリセット\n• 制御: いつでもiCloud同期を無効化"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "• Acesso: Visualizar todos os seus dados no aplicativo\n• Excluir: Redefinir todos os dados através de Configurações\n• Controle: Desativar a sincronização do iCloud a qualquer momento"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Erişim: Uygulama içinde tüm verilerinizi görüntüleyin\n• Silme: Ayarlar üzerinden tüm verileri sıfırlayın\n• Kontrol: iCloud senkronizasyonunu istediğiniz zaman devre dışı bırakın"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "• 访问：在应用内查看您的所有数据\n• 删除：通过设置重置所有数据\n• 控制：随时禁用iCloud同步"
          }
        }
      }
    },
