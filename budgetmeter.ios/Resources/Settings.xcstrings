    "settings.privacy.policy.data_sharing.content": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We do not share, sell, or transmit your personal data to any third parties."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا نشارك أو نبيع أو ننقل بياناتك الشخصية إلى أي أطراف ثالثة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir teilen, verkaufen oder übertragen Ihre persönlichen Daten nicht an Dritte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No compartimos, vendemos ni transmitimos sus datos personales a terceros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous ne partageons, ne vendons ni ne transmettons vos données personnelles à des tiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non condividiamo, vendiamo o trasmettiamo i tuoi dati personali a terze parti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人データを第三者と共有、販売、または送信することはありません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não compartilhamos, vendemos ou transmitimos seus dados pessoais a terceiros."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel verilerinizi hiçbir üçüncü taraf ile paylaşmıyor, satmıyor veya iletmiyoruz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们不会与任何第三方共享、出售或传输您的个人数据。"
          }
        }
      }
    },
    "settings.privacy.policy.data_storage.title": {
      "extractionState": "manual",
      "localizations": {
