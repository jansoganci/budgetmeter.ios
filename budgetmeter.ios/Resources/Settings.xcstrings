          "stringUnit": {
            "state": "translated",
            "value": "The app is provided 'as-is' without warranties of any kind, express or implied."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم توفير التطبيق 'كما هو' دون أي ضمانات من أي نوع، صريحة أو ضمنية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App wird 'wie besehen' ohne Gewährleistungen jeglicher Art, ausdrücklich oder stillschweigend, bereitgestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación se proporciona 'tal cual' sin garantías de ningún tipo, expresas o implícitas."
          }
        },
        "fr": {
          "stringUnit": {
