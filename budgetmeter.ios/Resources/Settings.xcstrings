            "value": "L'application est fournie 'telle quelle' sans garanties d'aucune sorte, expresses ou implicites."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app è fornita 'così com'è' senza garanzie di alcun tipo, espresse o implicite."
          }
