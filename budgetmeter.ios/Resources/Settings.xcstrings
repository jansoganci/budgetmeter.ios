    "settings.privacy.policy.data_collect.content": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Financial data (income, expenses, categories) - stored locally on your device\n• App preferences (currency, language) - stored locally\n• iCloud sync data (when enabled) - stored in your personal iCloud account"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "• البيانات المالية (الدخل، المصروفات، الفئات) - مخزنة محلياً على جهازك\n• تفضيلات التطبيق (العملة، اللغة) - مخزنة محلياً\n• بيانات مزامنة iCloud (عند التفعيل) - مخزنة في حساب iCloud الشخصي الخاص بك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "• Finanzdaten (Einkommen, Ausgaben, Kategorien) - lokal auf Ihrem Gerät gespeichert\n• App-Einstellungen (Währung, Sprache) - lokal gespeichert\n• iCloud-Synchronisierungsdaten (wenn aktiviert) - in Ihrem persönlichen iCloud-Konto gespeichert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "• Datos financieros (ingresos, gastos, categorías) - almacenados localmente en su dispositivo\n• Preferencias de la aplicación (moneda, idioma) - almacenadas localmente\n• Datos de sincronización de iCloud (cuando está habilitado) - almacenados en su cuenta personal de iCloud"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Données financières (revenus, dépenses, catégories) - stockées localement sur votre appareil\n• Préférences de l'application (devise, langue) - stockées localement\n• Données de synchronisation iCloud (lorsqu'elles sont activées) - stockées dans votre compte iCloud personnel"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "• Dati finanziari (entrate, spese, categorie) - memorizzati localmente sul tuo dispositivo\n• Preferenze dell'app (valuta, lingua) - memorizzate localmente\n• Dati di sincronizzazione iCloud (quando abilitati) - memorizzati nel tuo account iCloud personale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• 財務データ（収入、支出、カテゴリ）- デバイスにローカルに保存\n• アプリ設定（通貨、言語）- ローカルに保存\n• iCloud同期データ（有効化時）- 個人のiCloudアカウントに保存"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "• Dados financeiros (receitas, despesas, categorias) - armazenados localmente no seu dispositivo\n• Preferências do aplicativo (moeda, idioma) - armazenadas localmente\n• Dados de sincronização do iCloud (quando habilitado) - armazenados na sua conta pessoal do iCloud"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Finansal veriler (gelir, gider, kategoriler) - cihazınızda yerel olarak saklanır\n• Uygulama tercihleri (para birimi, dil) - yerel olarak saklanır\n• iCloud eşitleme verileri (etkinleştirildiğinde) - kişisel iCloud hesabınızda saklanır"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "• 财务数据（收入、支出、类别）- 本地存储在您的设备上\n• 应用偏好设置（货币、语言）- 本地存储\n• iCloud同步数据（启用时）- 存储在您的个人iCloud账户中"
          }
        }
      }
    },
    "settings.privacy.policy.data_use.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HOW WE USE DATA"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف نستخدم البيانات"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WIE WIR DATEN VERWENDEN"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CÓMO USAMOS LOS DATOS"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "COMMENT NOUS UTILISONS LES DONNÉES"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "COME UTILIZZIAMO I DATI"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データの使用方法"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "COMO USAMOS OS DADOS"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "VERİLERİ NASIL KULLANIYORUZ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们如何使用数据"
          }
        }
      }
    },
    "settings.privacy.policy.data_use.content": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• To provide financial tracking functionality\n• To sync across your devices via iCloud (optional)\n• All processing happens locally on your device"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "• لتوفير وظائف تتبع مالية\n• لمزامنة البيانات عبر أجهزتك عبر iCloud (اختياري)\n• تتم جميع المعالجات محلياً على جهازك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "• Zur Bereitstellung von Finanzverfolgungsfunktionen\n• Zur Synchronisierung über Ihre Geräte via iCloud (optional)\n• Alle Verarbeitungen erfolgen lokal auf Ihrem Gerät"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "• Para proporcionar funcionalidad de seguimiento financiero\n• Para sincronizar entre sus dispositivos a través de iCloud (opcional)\n• Todo el procesamiento ocurre localmente en su dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Pour fournir des fonctionnalités de suivi financier\n• Pour synchroniser sur vos appareils via iCloud (optionnel)\n• Tout le traitement se fait localement sur votre appareil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "• Per fornire funzionalità di monitoraggio finanziario\n• Per sincronizzare tra i tuoi dispositivi tramite iCloud (opzionale)\n• Tutte le elaborazioni avvengono localmente sul tuo dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• 財務追跡機能を提供するため\n• iCloud経由でデバイス間を同期するため（オプション）\n• すべての処理はデバイス上でローカルに実行されます"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "• Para fornecer funcionalidade de rastreamento financeiro\n• Para sincronizar entre seus dispositivos via iCloud (opcional)\n• Todo o processamento acontece localmente no seu dispositivo"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Finansal takip işlevselliği sağlamak için\n• iCloud aracılığıyla cihazlarınız arasında senkronize etmek için (isteğe bağlı)\n• Tüm işlemler cihazınızda yerel olarak gerçekleşir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "• 提供财务跟踪功能\n• 通过iCloud在您的设备间同步（可选）\n• 所有处理都在您的设备上本地进行"
          }
        }
      }
    },
    "settings.privacy.policy.data_sharing.title": {
      "extractionState": "manual",
