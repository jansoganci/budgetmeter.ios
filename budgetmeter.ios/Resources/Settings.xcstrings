    "settings.privacy.policy.data_storage.content": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Local: Core Data database on your device\n• Cloud: Your private iCloud account (optional)\n• No external servers or third-party databases"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "• محلي: قاعدة بيانات Core Data على جهازك\n• السحابة: حساب iCloud الشخصي الخاص بك (اختياري)\n• لا توجد خوادم خارجية أو قواعد بيانات تابعة لأطراف ثالثة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "• Lokal: Core Data-Datenbank auf Ihrem Gerät\n• Cloud: Ihr privates iCloud-Konto (optional)\n• Keine externen Server oder Drittanbieter-Datenbanken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "• Local: Base de datos Core Data en su dispositivo\n• Nube: Su cuenta privada de iCloud (opcional)\n• Sin servidores externos ni bases de datos de terceros"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Local : Base de données Core Data sur votre appareil\n• Cloud : Votre compte iCloud privé (optionnel)\n• Aucun serveur externe ni base de données tierce"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "• Locale: Database Core Data sul tuo dispositivo\n• Cloud: Il tuo account iCloud privato (opzionale)\n• Nessun server esterno o database di terze parti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• ローカル: デバイス上のCore Dataデータベース\n• クラウド: 個人のiCloudアカウント（オプション）\n• 外部サーバーやサードパーティのデータベースはありません"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "• Local: Banco de dados Core Data no seu dispositivo\n• Nuvem: Sua conta privada do iCloud (opcional)\n• Sem servidores externos ou bancos de dados de terceiros"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Yerel: Cihazınızdaki Core Data veritabanı\n• Bulut: Kişisel iCloud hesabınız (isteğe bağlı)\n• Harici sunucu veya üçüncü taraf veritabanı yok"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "• 本地：您设备上的Core Data数据库\n• 云：您的私人iCloud账户（可选）\n• 无外部服务器或第三方数据库"
          }
        }
      }
    },
    "settings.privacy.policy.your_rights.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "YOUR RIGHTS"
          }
        },
