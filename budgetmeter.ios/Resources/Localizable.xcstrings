    "insights.premium.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على رؤى مالية آلية وتفاصيل الإنفاق وتحليل الاتجاهات لاتخاذ قرارات مالية أذكى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalten Sie automatisierte Finanzeinblicke, Ausgabenaufschlüsselungen und Trendanalysen für klügere Geldentscheidungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get automated financial insights, spending breakdowns, and trend analysis to make smarter money decisions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtén información financiera automatizada, desgloses de gastos y análisis de tendencias para tomar decisiones más inteligentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenez des informations financières automatisées, des répartitions de dépenses et des analyses de tendances pour prendre des décisions plus intelligentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottieni informazioni finanziarie automatiche, suddivisioni delle spese e analisi delle tendenze per decisioni più intelligenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動財務インサイト、支出内訳、トレンド分析で賢いお金の決定をしましょう。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenha insights financeiros automatizados, detalhamento de gastos e análise de tendências para tomar decisões mais inteligentes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha akıllı para kararları için otomatik finansal içgörüler, harcama dökümleri ve trend analizleri alın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获取自动财务洞察、支出明细和趋势分析，做出更明智的理财决策。"
          }
        }
      }
    },
