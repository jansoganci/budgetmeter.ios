    "settings.privacy.sheet.bullet.icloud": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للمستخدمين Premium حفظ لقطات نسخ احتياطي يدوي اختيارية في Supabase. هذا منفصل عن مزامنة الحساب اليومية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium-Nutzer können optional manuelle Backups in Supabase speichern. Dies ist getrennt von der täglichen Kontosynchronisierung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium users can optionally save manual backup snapshots to Supabase. This is separate from everyday account sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los usuarios Premium pueden guardar instantáneas de copia manual opcionales en Supabase. Esto es independiente de la sincronización diaria de la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les utilisateurs Premium peuvent enregistrer des sauvegardes manuelles optionnelles sur Supabase. C'est séparé de la synchronisation quotidienne du compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli utenti Premium possono salvare snapshot di backup manuali opzionali su Supabase. Questo è separato dalla sincronizzazione quotidiana dell'account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレミアムユーザーは任意で手動バックアップスナップショットをSupabaseに保存できます。これは日常のアカウント同期とは別です。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuários Premium podem salvar instantâneos de backup manual opcionais no Supabase. Isso é separado da sincronização diária da conta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premium kullanıcılar isteğe bağlı olarak manuel yedek anlık görüntülerini Supabase'e kaydedebilir. Bu, günlük hesap eşitlemesinden ayrıdır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级用户可以选择将手动备份快照保存到 Supabase。这与日常账户同步分开。"
          }
        }
      }
    },
    "settings.privacy.sheet.bullet.local": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المستخدمون المجانيون: تبقى بياناتك المالية على هذا الجهاز دون تخزين سحابي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlose Nutzer: Deine Finanzdaten bleiben auf diesem Gerät ohne Cloud-Speicherung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free users: your financial data stays on this device with no cloud storage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuarios gratuitos: tus datos financieros permanecen en este dispositivo sin almacenamiento en la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisateurs gratuits : vos données financières restent sur cet appareil sans stockage cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utenti gratuiti: i tuoi dati finanziari restano su questo dispositivo senza archiviazione cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料ユーザー：財務データはクラウド保存なしでこのデバイスに残ります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuários gratuitos: seus dados financeiros permanecem neste dispositivo sem armazenamento na nuvem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz kullanıcılar: finansal verilerin bulut depolama olmadan bu cihazda kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费用户：您的财务数据保留在此设备上，不使用云存储。"
          }
        }
      }
    },
    "settings.privacy.sheet.bullet.personal": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن نبيع أو نشارك معلوماتك الشخصية أبداً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir verkaufen oder teilen deine persönlichen Daten niemals."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We never sell or share personal information."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca vendemos ni compartimos tu información personal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous ne vendons ni ne partageons jamais vos informations personnelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non vendiamo né condividiamo mai le tue informazioni personali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人情報を販売したり共有したりすることはありません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca vendemos ou compartilhamos suas informações pessoais."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel bilgilerinizi asla satmaz veya paylaşmayız."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们绝不会出售或共享您的个人信息。"
          }
        }
      }
    },
    "settings.privacy.sheet.bullet.share": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت تختار ما تريد تصديره أو مشاركته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du entscheidest, was du exportierst oder teilst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You choose what to export or share."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú decides qué exportar o compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous choisissez ce que vous exportez ou partagez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Decidi tu cosa esportare o condividere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何をエクスポートまたは共有するかはあなたが決めます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você decide o que exportar ou compartilhar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne paylaşacağınıza veya dışa aktaracağınıza siz karar verirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由您决定导出或分享哪些内容。"
          }
        }
      }
    },
    "settings.privacy.sheet.intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تخزين بياناتك محلياً على جهازك. عند تسجيل الدخول، تتم مزامنة بيانات حسابك مع Supabase. يمكن للمستخدمين Premium إنشاء لقطات نسخ احتياطي يدوي اختيارية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Daten werden lokal auf Ihrem Gerät gespeichert. Bei Anmeldung werden Ihre Kontodaten mit Supabase synchronisiert. Premium-Nutzer können optional manuelle Backups erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data is stored locally on your device. When you sign in, your account data syncs to Supabase. Premium users can optionally create manual backup snapshots."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos se almacenan localmente en tu dispositivo. Cuando inicias sesión, tus datos de cuenta se sincronizan con Supabase. Los usuarios Premium pueden crear instantáneas de copia manual opcionales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données sont stockées localement sur votre appareil. Lorsque vous vous connectez, vos données de compte sont synchronisées avec Supabase. Les utilisateurs Premium peuvent créer des sauvegardes manuelles optionnelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati sono memorizzati localmente sul dispositivo. Quando accedi, i dati dell'account vengono sincronizzati con Supabase. Gli utenti Premium possono creare snapshot di backup manuali opzionali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データはデバイスにローカル保存されます。サインインすると、アカウントデータがSupabaseに同期されます。プレミアムユーザーは任意で手動バックアップスナップショットを作成できます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados são armazenados localmente no dispositivo. Quando você entra, os dados da conta são sincronizados com o Supabase. Usuários Premium podem criar instantâneos de backup manual opcionais."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verileriniz cihazınızda yerel olarak saklanır. Giriş yaptığınızda hesap verileriniz Supabase'e eşitlenir. Premium kullanıcılar isteğe bağlı olarak manuel yedek anlık görüntüleri oluşturabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的数据本地存储在设备上。登录后，账户数据会同步到 Supabase。高级用户可以选择创建手动备份快照。"
          }
        }
      }
    },
