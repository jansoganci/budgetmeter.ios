        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottieni una panoramica completa dei tuoi progressi finanziari ogni domenica sera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎週日曜日の夜に財務進捗の包括的な概要を取得します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenha uma visão geral abrangente do seu progresso financeiro todo domingo à noite."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her Pazar akşamı mali ilerlemenizin kapsamlı bir özetini alın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每周日晚上获取您财务进度的全面概述。"
          }
        }
      }
    },
