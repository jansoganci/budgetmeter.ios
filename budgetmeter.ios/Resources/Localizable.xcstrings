    "settings.reset.all.warning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الإجراء يحذف جميع البيانات نهائياً ولا يمكن التراجع عنه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion löscht alle Daten dauerhaft und kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action permanently deletes all data and cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción elimina todos los datos de forma permanente y no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprime définitivement toutes les données et est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione elimina definitivamente tutti i dati e non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作でデータは完全に削除され、元に戻せません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa ação exclui todos os dados permanentemente e não pode ser desfeita."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem tüm verileri kalıcı olarak siler ve geri alınamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作会永久删除所有数据，且无法撤销。"
          }
        }
      }
    },
