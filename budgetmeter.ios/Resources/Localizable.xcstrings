    "notifications.daily.time_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم إرسال الإشعار كل يوم في هذا الوقت"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Benachrichtigung wird täglich zu dieser Zeit gesendet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification will be sent every day at this time"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La notificación se enviará todos los días a esta hora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La notification sera envoyée tous les jours à cette heure"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La notifica verrà inviata ogni giorno a quest'ora"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日この時間に通知が送信されます"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A notificação será enviada todos os dias neste horário"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirim her gün bu saatte gönderilecek"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知将每天在此时间发送"
          }
        }
      }
    },
