    "notifications.info.daily": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ كل يوم بنصائح مالية شخصية وتحفيز. (مميز)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten Sie jeden Tag mit personalisierten Finanztipps und Motivation. (Premium)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start each day with personalized financial tips and motivation. (Premium)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comienza cada día con consejos financieros personalizados y motivación. (Premium)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez chaque jour avec des conseils financiers personnalisés et de la motivation. (Premium)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia ogni giorno con consigli finanziari personalizzati e motivazione. (Premium)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日パーソナライズされた財務アドバイスとモチベーションで始めましょう。(プレミアム)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece cada dia com dicas financeiras personalizadas e motivação. (Premium)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her güne kişiselleştirilmiş finansal ipuçları ve motivasyonla başlayın. (Premium)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天以个性化的财务提示和鼓励开始。(高级版)"
          }
        }
      }
    },
    "notifications.info.milestones": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفل بسلسلة الإنفاق الإيجابية وإنجاز الأهداف فور حدوثها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feiern Sie positive Ausgabensträhnen und Zielerreichungen, wenn sie passieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Celebrate positive spending streaks and goal achievements as they happen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Celebra rachas de gasto positivas y logros de metas cuando ocurran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Célébrez les séries de dépenses positives et les objectifs atteints au fur et à mesure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Celebra le serie di spesa positive e il raggiungimento degli obiettivi quando accadono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポジティブな支出ストリークと目標達成をリアルタイムで祝いましょう。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Celebre sequências de gastos positivos e conquistas de metas quando acontecerem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olumlu harcama serilerini ve hedef başarılarını gerçekleştiklerinde kutlayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在积极消费连续记录和目标达成时庆祝。"
          }
        }
      }
    },
    "notifications.info.spending": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على تحذيرات مبكرة عندما يزداد إنفاقك بشكل ملحوظ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalten Sie frühe Warnungen, wenn Ihre Ausgaben erheblich steigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receive early warnings when your spending increases significantly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe advertencias tempranas cuando tus gastos aumenten significativamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez des alertes précoces lorsque vos dépenses augmentent significativement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi avvisi precoci quando le tue spese aumentano significativamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支出が大幅に増加した場合に早期警告を受け取ります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba alertas antecipados quando seus gastos aumentarem significativamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harcamalarınız önemli ölçüde arttığında erken uyarılar alın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当您的支出显著增加时收到早期警告。"
          }
        }
      }
    },
    "notifications.info.weekly": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على نظرة شاملة عن تقدمك المالي كل مساء أحد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalten Sie jeden Sonntagabend einen umfassenden Überblick über Ihren finanziellen Fortschritt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
