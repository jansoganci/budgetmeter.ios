    "home.getting_started.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع تدفق أموالك في الوقت الفعلي.\\nابدأ بإضافة مصادر دخلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolgen Sie Ihren Geldfluss in Echtzeit.\\nBeginnen Sie mit dem Hinzufügen Ihrer Einkommensquellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track your money flow in real-time.\\nStart by adding your income sources."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastrea tu flujo de dinero en tiempo real.\\nComienza agregando tus fuentes de ingresos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez votre flux d'argent en temps réel.\\nCommencez par ajouter vos sources de revenus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traccia il flusso dei tuoi soldi in tempo reale.\\nInizia aggiungendo le tue fonti di reddito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リアルタイムでお金の流れを追跡しましょう。\\n収入源を追加することから始めてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe seu fluxo de dinheiro em tempo real.\\nComece adicionando suas fontes de renda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Para akışınızı gerçek zamanlı takip edin.\\nGelir kaynaklarınızı ekleyerek başlayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时追踪您的资金流动。\\n首先添加您的收入来源。"
          }
        }
      }
    },
