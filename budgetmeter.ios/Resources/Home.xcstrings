    "home.target.message.negative": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صافي التدفق سلبي. زد الدخل أو قلل المصروفات لتحقيق الهدف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Nettofluss ist negativ. Erhöhe dein Einkommen oder reduziere Ausgaben, um das Ziel zu erreichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your net flow is negative. Increase income or reduce expenses to reach the target."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu flujo neto es negativo. Aumenta ingresos o reduce gastos para alcanzar el objetivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre flux net est négatif. Augmentez les revenus ou réduisez les dépenses pour atteindre l'objectif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il flusso netto è negativo. Aumenta le entrate o riduci le spese per raggiungere l'obiettivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "純収支がマイナスです。目標達成には収入増か支出削減が必要です。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu fluxo líquido é negativo. Aumente a renda ou reduza as despesas para alcançar a meta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Net akışınız negatif. Hedefe ulaşmak için geliri artırın veya giderleri azaltın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "净流入为负。请增加收入或减少支出以达到目标。"
